{
  "version": "1.0-week1",
  "project": "ISO/IEC 27001:2022 AI Agent Compliance Assessment",
  "owner": "Lê Đăng Khoa (System & Evidence Tools)",
  "security_principles": {
    "collection_mode": "READ_ONLY",
    "integrity_hash": "SHA-256",
    "untrusted_input_handling": "SANITIZE_BEFORE_AGENT_EVAL"
