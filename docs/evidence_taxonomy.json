          "mapped_controls": ["A.6.1", "A.6.2", "A.6.4", "A.6.7", "A.6.8", "A.8.25", "A.8.26", "A.8.27"]
        },
        {
          "evidence_type": "EVID_PPL_TRAINING",
          "name": "Hồ sơ đào tạo nhận thức ATTT và kết quả kiểm tra",
          "formats": [".csv", ".json", ".pdf"],
          "mapped_controls": ["A.6.3"]
        },
        {
          "evidence_type": "EVID_PPL_CONTRACT_NDA",
          "name": "Thỏa thuận bảo mật (NDA) và điều khoản lao động",
